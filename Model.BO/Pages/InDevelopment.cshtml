@page
@{
    ViewData["Title"] = "Page en cours de développement";
}
<!DOCTYPE html>
<html lang="zxx">
<body>

    <navigation-menu/>
    <main-header/>

    <main class="nxl-container d-flex flex-column justify-content-between background-image">
        <div class="nxl-content">
            <!-- [ page-header ] start -->
            <div class="page-header">
                <div class="page-header-left d-flex align-items-center">
                    <div class="page-header-title">
                        <h5 class="m-b-10">Erreur</h5>
                    </div>
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a>Page inaccessible</a></li>
                    </ul>
                </div>

            </div>
            <!-- [ page-header ] end -->
            <!-- [ Main Content ] start -->
            <div class="main-content ">
                <div class="column">
                    <div class="col-lg-12">
                        <div class="card stretch stretch h-100">
                            <div class="card-body general-info">
                                <div class="mb-5 d-flex align-items-center justify-content-between">
                                    <h5 class="fw-bold mb-0 me-4">
                                        <span class="d-block mb-2">Page en cours de développement:</span>
                                        <span id="page-name-inner-title" class="fs-19 fw-normal text-muted">Cette page est actuellement en cours de développement.</span>
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- [ Main Content ] end -->
        </div>
        <main-footer/>
    </main>
</body>
</html>