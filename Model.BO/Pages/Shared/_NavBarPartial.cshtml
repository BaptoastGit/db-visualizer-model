@using System.Text.Json.Nodes;
@using Microsoft.AspNetCore.Authorization


@{
    JsonNode pageConfig = JsonNode.Parse(System.IO.File.ReadAllText("wwwroot/data/pagesLayout.json"));
    JsonNode navGroups = JsonNode.Parse(System.IO.File.ReadAllText("wwwroot/data/data.json"))["NavigationGroupsIcons"];

}
<nav class="nxl-navigation sidebar" id="navbar">
    <div class="navbar-wrapper">
        <div class="m-header">
            <a href="~/TablePages/TableDashboard?TableName=Accounts" class="b-brand">
                <img src="https://img.icons8.com/?size=100&id=Md3k8zGyt289&format=png&color=000000" style="max-height:50px"></img>
            </a>
        </div>
        <div class="navbar-content">
            <ul class="nxl-navbar">
                <li class="nxl-item nxl-caption">
                    <label>Navigation</label>
                </li>


                        @foreach (var navGroup in (JsonObject)navGroups)
                        {
                           <li class="navbar-dropdown">
                        <a type="button" data-bs-toggle="collapse" href="#collapse@(navGroup.Key)" role="button" aria-expanded="false" aria-controls="collapse@(navGroup.Key)" class="nxl-link nav-link nav-group d-flex justify-content-between">
                                    <div>
                                        <span class="nxl-micon"><i class="@(navGroup.Value)"></i></span>
                                        <span class="nxl-mtext">@(navGroup.Key)</span>
                                    </div>
                                    <div class="d-flex justify-content-end">
                                        <i class="bi-chevron-right" ></i>
                                <i class="bi-chevron-down" style="display:none"></i>

                                    </div>

                                </a>
                                <div class="collapse collapseNavBar pb-1" id="collapse@(navGroup.Key)">

                                @foreach (var page in (JsonObject)pageConfig)
                                    {
                                        JsonNode jsonValues = page.Value.AsObject();
                                @if (jsonValues["NavigationGroup"].ToString() == navGroup.Key)
                                {
                                    Console.WriteLine(page.Key);


                                    <div class="nxl-item">
                                        <a href="~/TablePages/TableDashboard?TableName=@(jsonValues["Table"])" page="@(jsonValues["Table"])" class="nxl-link nav-link sub-nav-link">
                                            <span class="nxl-micon fs-12"><i class="@(jsonValues["TabIcon"]) fs-6"></i></span>
                                            <span class="nxl-mtext fs-12">@(page.Key)</span>
                                        </a>
                                    </div>
                                    
                                }

                                    }
                               </div>
                           </li>
                        } 
            </ul>
        </div>
    </div>
</nav>