@page
@using System.Text.Json.Nodes;
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model Model.BO.Pages.Orders.PricesModel
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Prices";
}   

<!DOCTYPE html>
<html lang="zxx">

<head>
    <!--! BEGIN: Custom scripts JS-->
    <script src="~/assets/js/components/filter-menu.js"></script>
    <script src="~/assets/js/components/table-header.js"></script>
    <script src="~/assets/js/page-functions/commande.js"></script>
    <script src="~/assets/js/shared/table-column-resizing.js"></script>
    <script src="~/assets/js/shared/sort.js"></script>
    <script src="~/assets/js/shared/table-reload.js"></script>
    <script src="~/assets/js/components/custom-select.js"></script>
    <script src="~/assets/js/shared/edit-table-cell-values.js"></script>

    <!--! END: Custom scripts JS-->
</head>

<body>

    <navigation-menu />

    <main-header />
   

    <main class="nxl-container d-flex flex-column justify-content-between background-image">
        <div class="nxl-content bg-transparent d-flex flex-column flex-grow-1">
            <!-- [ page-header ] start -->
            <page-header />
            <!-- [ page-header ] end -->
            <!-- [ Main Content ] start -->
            <div class="main-content  flex-grow-1" style="height:100%; display:block; overflow-x:auto;">
                <div class="row">
                    @if (!String.IsNullOrEmpty(Request.Query["success"]) || !String.IsNullOrEmpty(Model.successMessage))
                    {
                        <div class='alert alert-success alert-dismissible mb-4' role="alert">
                            <strong id="AlertText">@Model.successMessageList.GetValueOrDefault((!String.IsNullOrEmpty(Request.Query["success"])) ? Request.Query["success"] : Model.successMessage)</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    }
                    <div class="col-lg-12">

                        <div class="card stretch stretch-full ">
                            <div class="collapse" id="collapseFilter">
                                <div class="card card-body">
                                    <form method="get" id="SortForm">

                                        <input type="hidden" name="SortBy" id="SortBy" value="Nom Clé" />
                                        <input type="hidden" name="Order" id="Order" value="0" />
                                        <input type="hidden" name="Success" id="Success" value="" />
                                        <button type="submit" class="btn btn-primary d-none" id="SearchButton">
                                            Rechercher
                                        </button>

                                    </form>

                                </div>
                            </div>
                            <partial name="_tablePartial" />
                            @if ((await AuthorizationService.AuthorizeAsync(User, "RequireEditorPrices")).Succeeded)
                            {
                                <script>
                                    makeColumnEditable("Value");

                                </script>
                            }
                             
                            <form id="form" method="post" class="edit-forms">
                                <input type="hidden" name="FormType" value="Value" />

                            </form>
                            
                        </div>
                    </div>
                    <div class="d-flex justify-content-center mt-0">
                        <span id="rowCounter">Affichage de @ViewContext.HttpContext.Items["rowCount"] résultat@(ViewContext.HttpContext.Items["rowCount"].ToString() != "1" ? "s" : "")</span>
                    </div>
                </div>
            </div>
            <!-- [ Main Content ] end -->
        </div>

        <main-footer />

    </main>
</body>
</html>