@page
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model Model.BO.Pages.TablePages.TableDashBoardModel
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = string.IsNullOrEmpty(Request.Query["TableName"])  ? "Accounts" : Request.Query["TableName"];
}

<!DOCTYPE html>
<html lang="zxx">

<head>
    <!--! BEGIN: Custom scripts JS-->
    <script src="~/assets/js/components/filter-menu.js"></script>
    <script src="~/assets/js/components/table-header.js"></script>
    <script src="~/assets/js/page-functions/chargementPIM.js"></script>
    <script src="~/assets/js/shared/table-column-resizing.js"></script>
    <script src="~/assets/js/shared/edit-table-cell-values.js"></script>
    <script src="~/assets/js/shared/sort.js"></script>
    <script src="~/assets/js/components/custom-select.js"></script>
    <!--! END: Custom scripts JS-->
</head>

<body>

    <partial name="_NavBarPartial" />

    <main-header />

    <main class="nxl-container d-flex flex-column justify-content-between background-image">
        <div class="nxl-content bg-transparent d-flex flex-column flex-grow-1 ">
            <!-- [ page-header ] start -->
            <page-header />
            <!-- [ page-header ] end -->
            <!-- [ Main Content ] start -->
            <div class="main-content  flex-grow-1" style="height:100%; display:block; overflow-x:auto;">
                <div class="row">
                    @if (!String.IsNullOrEmpty(Request.Query["success"]) || !String.IsNullOrEmpty(Model.successMessage))
                    {
                        <div class='alert alert-success alert-dismissible mb-4' role="alert">
                            <strong id="AlertText">@Model.successMessageList.GetValueOrDefault((!String.IsNullOrEmpty(Request.Query["success"])) ? Request.Query["success"] : Model.successMessage)</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    }
                    @if (!String.IsNullOrEmpty(Request.Query["error"]) || !String.IsNullOrEmpty(Model.errorMessage))
                    {
                        <div class='alert alert-danger alert-dismissible mb-4' role="alert">
                            <strong id="AlertText">Erreur: @Request.Query["error"]</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    }
                    <div class="col-lg-12">

                        <div class="card stretch stretch-full ">
                            <partial name="_ActionsHeaderPartial" />
                            <partial name="_tablePartial" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-center mt-0">
                        <span id="rowCounter">Affichage de @ViewContext.HttpContext.Items["rowCount"] résultat@(ViewContext.HttpContext.Items["rowCount"].ToString() != "1" ? "s" : "")</span>
                    </div>
                </div>
            </div>
            <form method="post" id="form">
            </form>
            @{
                JsonNode pageConfig = JsonNode.Parse(System.IO.File.ReadAllText("wwwroot/data/pagesLayout.json"))[ViewData["title"].ToString()];
            }
            @if (pageConfig?["EditableColumns"] is JsonArray editableColumns && (await AuthorizationService.AuthorizeAsync(User, "RequireEditor" + ViewData["title"].ToString())).Succeeded)
            {

                <script>
                                makeColumnEditable(@Json.Serialize(editableColumns));
                </script>
                @foreach (string column in editableColumns)
                {
                    <form method="post" class="edit-forms" id="@(column)Form">
                        <input type="hidden" name="FormType" value="@(column)" />
                        <input type="hidden" name="TableName" value="@(ViewData["Title"])" />
                    </form>
                }
            }
            <form method="post" class="edit-forms" id="Deleteform">
                <input type="hidden" name="FormType" value="Delete" />
                <input type="hidden" name="TableName" value="@(ViewData["Title"])" />
            </form>
            <!-- [ Main Content ] end -->
        </div>

        <main-footer />

    </main>
</body>
</html>