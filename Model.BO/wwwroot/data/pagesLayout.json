      },
      "OrderStatus": {
        "DBColumn": "OrderStatus"
      },
      "PaymentStatus": {
        "DBColumn": "PaymentStatus"
      },
      "TotalAmount": {
        "DBColumn": "TotalAmount",
        "Type": "Number"
      },
      "Currency": {
        "DBColumn": "Currency"
      },
      "ShippingMethod": {
        "DBColumn": "ShippingMethod"
      },
      "TrackingNumber": {
        "DBColumn": "TrackingNumber"
      },
      "ItemCount": {
        "DBColumn": "ItemCount",
        "Type": "Number"
      },
      "OrderedOn": {
        "DBColumn": "OrderedOn",
        "Type": "DateTime"
      }
    },
    "VisibleColumnsOnMobile": [ "OrderNumber", "OrderStatus", "TotalAmount", "OrderedOn" ],
    "Default message": "No order found."
  },
  "Prices": {
    "Table": "Prices",
    "NavigationGroup": "Orders",
    "TabIcon": "feather-credit-card",
    "Colonnes Tables": {
      "Sku": {
        "DBColumn": "Sku"
      },
      "PriceListCode": {
        "DBColumn": "PriceListCode"
      },
      "Amount": {
        "DBColumn": "Amount",
        "Type": "Number"
      },
      "Currency": {
        "DBColumn": "Currency",
        "Type": "Fixed Values",
        "ValuesList": "Currency",
        "SelectAllOptionsLabel": "Any"
      },
      "ValidFrom": {
        "DBColumn": "ValidFrom",
        "Type": "DateTime"
      },
      "ValidTo": {
        "DBColumn": "ValidTo",
        "Type": "DateTime"
      }
    },
    "VisibleColumnsOnMobile": [ "Sku", "Amount", "ValidTo" ],
