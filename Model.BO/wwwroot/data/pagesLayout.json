      },
      "WeightKg": {
        "DBColumn": "WeightKg",
        "Type": "Number"
      },
      "ModifiedOn": {
        "DBColumn": "ModifiedOn",
        "Type": "DateTime"
      }
    },
    "VisibleColumnsOnMobile": [ "Sku", "Category", "WeightKg" ],
