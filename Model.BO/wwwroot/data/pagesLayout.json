{
  "Accounts": {
    "Table": "Accounts",
    "NavigationGroup": "UsersData",
    "TabIcon": "feather-loader",
    "Colonnes Tables": {
      "Id": {
        "DBColumn": "Id",
        "Width": "10"
      },
      "Name": {
        "DBColumn": "Name",
        "Width": "8"
      },
      "Type": {
        "DBColumn": "Type",
        "Width": "8"
      },
      "Status": {
        "DBColumn": "Status",
        "Width": "8",
        "Type": "Fixed Values",
        "ValuesList": "Status",
        "SelectAllOptionsLabel": "Any"
      },
      "Tier": {
        "DBColumn": "Tier",
        "Width": "8"
      },
      "Balance": {
        "DBColumn": "Balance",
        "Width": "8",
        "Type": "Number"
      },
      "Is Vat Exempt": {
        "DBColumn": "IsVatExempt",
        "Width": "12",
        "Type": "Fixed Values",
        "ValuesList": "Bool",
        "SelectAllOptionsLabel": "Select all"
      },
      "Created On": {
        "DBColumn": "CreatedOn",
        "Width": "12",
        "Type": "DateTime"
      }
    },
    "Header Actions": {
      "Send verification link": {
        "Icon": "bi-upload",
        "Function": "SendSelectedFileNames('VerificationLink')"
      },
      "Add account to log": {
        "Icon": "bi-arrow-repeat",
        "Function": "SendSelectedFileNames('Log')"
      }
    },
    "VisibleColumnsOnMobile": [ "Id", "Name", "Tier" ],
    "Default message": "No account found."
  },
  "Users": {
    "Table": "Users",
    "NavigationGroup": "UsersData",
    "TabIcon": "feather-airplay",
    "Colonnes Tables": {
      "Id": {
        "DBColumn": "Id"
      },
      "Email": {
        "DBColumn": "Email"
      },
      "Username": {
        "DBColumn": "Username"
      },
      "CreatedOn": {
        "DBColumn": "CreatedOn",
        "Type": "DateTime"
      },
      "FailedLoginAttempts": {
        "DBColumn": "FailedLoginAttempts",
        "Type": "Number"
      },
      "PhoneNumber": {
        "DBColumn": "PhoneNumber"
      },
      "InternalNotes": {
        "DBColumn": "InternalNotes",
        "Type": "Fixed Values",
        "ValuesList": "Note",
        "SelectAllOptionsLabel": "Select all"
      }
    },
    "Colonne Actions": {
      "Buttons": {
        "User details": {
          "StatusRequired": "ReaderUsers",
          "Icon": "bi-eye",
          "Link": {
            "Href": "~/UserData/UserDetail",
            "Parameters": {
              "Id": "Id"
            }
          }
        }
      }
    },
    "VisibleColumnsOnMobile": [ "Email", "Username", "CreatedOn" ],
    "EditableColumns": [ "PhoneNumber", "InternalNotes" ],
    "Default message": "No user found."

  },
  "Messages": {
    "Table": "Messages",
    "NavigationGroup": "Messages",
    "TabIcon": "bi-chat-left-dots",
    "Colonnes Tables": {
      "Number of retries": {
        "DBColumn": "RetryCount",
        "Type": "Number"
      },
      "ErrorMessage": {
        "DBColumn": "ErrorMessage"
      },
      "Priority": {
        "DBColumn": "Priority"
      },
      "PayloadSize": {
        "DBColumn": "PayloadSize"
      },
      "ProcessedOn": {
        "DBColumn": "ProcessedOn",
        "Type": "DateTime"
      },
      "CorrelationId": {
        "DBColumn": "CorrelationId"
      }
    },
    "VisibleColumnsOnMobile": [ "ErrorMessage", "Priority", "PayloadSize" ],
    "EditableColumns": [ "ProcessedOn", "CorrelationId", "Priority" ],
    "DeletableRows": true,
    "Default message": "No message found."
  },
  "Orders": {
    "Table": "Orders",
    "NavigationGroup": "Orders",
